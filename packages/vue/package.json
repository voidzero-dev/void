{
  "name": "@void/vue",
  "version": "1.1.12",
  "description": "Vue pages, server rendering, forms, and navigation for Void.",
  "homepage": "https://void.cloud",
  "bugs": {
    "url": "https://github.com/voidzero-dev/void/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voidzero-dev/void.git",
    "directory": "packages/vue"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "import": "./dist/plugin.mjs"
    },
    "./deferred": {
      "types": "./dist/runtime/use-deferred.d.mts",
      "import": "./dist/runtime/use-deferred.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit --rootDir ../.."
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.10"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "pathslash": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "void": "workspace:*",
    "vue": "^3.5.44"
  },
  "peerDependencies": {
    "vite": "^8.0.0",
    "void": "workspace:*",
    "vue": "^3.5.0"
  }
}
