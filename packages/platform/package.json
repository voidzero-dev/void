{
  "name": "@void/platform",
  "version": "1.1.12",
  "description": "Packaged runtime and installation contracts for self-hosted Void platforms.",
  "homepage": "https://void.cloud",
  "bugs": {
    "url": "https://github.com/voidzero-dev/void/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voidzero-dev/void.git",
    "directory": "packages/platform"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./installer": {
      "types": "./dist/installer.d.mts",
      "import": "./dist/installer.mjs"
    },
    "./email-protocol": {
      "types": "./dist/email-protocol.d.mts",
      "import": "./dist/email-protocol.mjs"
    },
    "./plans": {
      "types": "./dist/plans.d.mts",
      "import": "./dist/plans.mjs"
    },
    "./browser-page": {
      "types": "./dist/browser-page.d.mts",
      "import": "./dist/browser-page.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && node scripts/build-runtime.mjs",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pathslash": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  }
}
