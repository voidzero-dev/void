{
  "name": "@void/md",
  "version": "1.2.1",
  "description": "Markdown pages with layouts and interactive islands for Void.",
  "homepage": "https://void.cloud",
  "bugs": {
    "url": "https://github.com/voidzero-dev/void/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voidzero-dev/void.git",
    "directory": "packages/md"
  },
  "files": [
    "dist",
    "pages.d.ts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "import": "./dist/plugin.mjs"
    },
    "./pages": {
      "types": "./pages.d.ts"
    },
    "./theme.css": "./dist/theme/index.css",
    "./theme-content.css": "./dist/theme/content.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit --rootDir ../.."
  },
  "dependencies": {
    "@shikijs/engine-javascript": "^4.5.0",
    "@shikijs/transformers": "^4.5.0",
    "gray-matter": "^4.0.3",
    "markdown-exit": "^1.3.0",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-container": "^4.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "pathslash": "catalog:",
    "shiki": "^4.5.0",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "void": "workspace:*"
  },
  "peerDependencies": {
    "vite": "^8.0.0",
    "void": "workspace:*"
  }
}
