  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:platform",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@void/react": "workspace:*",
    "@voidcloud/api": "workspace:*",
    "typescript": "catalog:",
