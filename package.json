{
  "private": true,
  "type": "module",
  "scripts": {
    "build:docs": "vp run --filter ./docs build",
    "check:platform": "vp run --filter './platform/**' --parallel typecheck",
    "check:sdk": "vp run --filter './packages/**' --parallel typecheck",
    "check:types": "vp run --filter './**' --filter '!./playground-local/**' --parallel --concurrency-limit=4 typecheck",
    "deploy:docs": "vp run build:core && node packages/void/dist/cli/cli.mjs deploy",
    "dev:docs": "vp run --filter ./docs dev",
    "dev:platform": "vp run --filter @voidcloud/platform dev",
    "fmt": "vp fmt --write .",
    "install:void-dev": "vp run build:core && node scripts/void-dev-link.mjs install",
    "lint": "vp lint",
    "prepare": "vp config && vp run build:core",
    "uninstall:void-dev": "node scripts/void-dev-link.mjs uninstall"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "catalog:",
    "cross-spawn": "^7.0.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "catalog:",
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue": "catalog:"
  },
  "packageManager": "pnpm@12.21.0"
}
