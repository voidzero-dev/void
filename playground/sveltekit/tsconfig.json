{
  "extends": ["$app/tsconfig", "./.void/tsconfig.json"],
  "compilerOptions": {
    "noEmit": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "types": ["$app/types", "void/env"],
    "allowImportingTsExtensions": true
  },
  "include": ["env.d.ts", "src", "db", "crons", "queues", "*.ts"]
}
