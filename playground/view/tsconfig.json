{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "jsxImportSource": "@void/view",
    "allowImportingTsExtensions": true,
    "types": ["vite/client"]
  },
  "include": ["pages", "components"]
}
